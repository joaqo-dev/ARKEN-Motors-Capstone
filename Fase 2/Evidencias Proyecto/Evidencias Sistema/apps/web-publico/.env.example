# URL de la API vista desde el servidor de Next.js (SSR)
API_URL=http://localhost:4000
# URL pública de la API (fotos que carga el navegador)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Dominio raíz: cada vitrina vive en <subdominio>.<dominio raíz>
# Desarrollo: localhost:3000 (abrir http://autos-demo.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Panel de gestión (enlace "Publica tu automotora")
NEXT_PUBLIC_PANEL_URL=http://localhost:3001
# Titular de Vitriauto en /terminos y /privacidad. Si faltan, las páginas
# muestran el dato entre corchetes: completarlos antes de producción.
LEGAL_RAZON_SOCIAL=
LEGAL_RUT=
LEGAL_DOMICILIO=
LEGAL_CORREO=
LEGAL_CIUDAD=
