NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://vitriauto:vitriauto@localhost:5432/vitriauto_dev
# Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_SEGUNDOS=900
REFRESH_TTL_DIAS=7
# Panel de Gestión: base de los links de los correos
APP_URL=http://localhost:3001
# Sitio público (marketplace): enlace "no quiero recibir más recordatorios"
SITIO_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
# En producción: .tudominio.cl
COOKIE_DOMAIN=
# Archivos subidos (fotos públicas y documentos privados)
UPLOADS_DIR=./uploads
# Sin key (fuera de producción) los correos se imprimen en el log de la API
RESEND_API_KEY=
# Dirección de envío (dominio verificado en Resend). En los correos a clientes
# se muestra con el nombre de cada automotora y las respuestas van a su email.
EMAIL_FROM=Automotoras <onboarding@resend.dev>
