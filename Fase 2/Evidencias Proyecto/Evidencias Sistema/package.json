{
  "name": "vitriauto",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "node-pg-migrate -m migrations -j sql --envPath .env up",
    "db:reset": "node scripts/db-reset.mjs",
    "db:nueva": "node-pg-migrate create -m migrations -j sql"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "dotenv": "^18.0.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "source-map-js@<1.2.2": "^1.2.2",
      "qs@<6.16.0": "^6.16.0",
      "handlebars@<4.7.10": "^4.7.10",
      "glob@>=11 <11.1.0": "^11.1.0"
    }
  }
}
