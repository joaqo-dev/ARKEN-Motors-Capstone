# Variables de producción (docs/07-despliegue.md). En el VPS: copiar a
# deploy/.env (nunca se versiona) y completar. compose.yml no arranca si falta
# una obligatoria.

# Dominio raíz, sin https ni barra: marketplace en DOMINIO, vitrinas en
# <subdominio>.DOMINIO, panel en app.DOMINIO y API en api.DOMINIO.
DOMINIO=

# Base de datos (solo en la red interna de Docker). Contraseña: openssl rand -hex 32
POSTGRES_USER=vitriauto
POSTGRES_DB=vitriauto
POSTGRES_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=

# Resend: API key de producción y remitente de un dominio verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=Vitriauto <no-responder@tudominio.cl>

# Caddy: aviso de Let's Encrypt y token de Cloudflare con permiso
# Zone > DNS > Edit, restringido a esta zona.
ACME_EMAIL=
CLOUDFLARE_API_TOKEN=

# Titular de Vitriauto en /terminos y /privacidad.
LEGAL_RAZON_SOCIAL=
LEGAL_RUT=
LEGAL_DOMICILIO=
LEGAL_CORREO=
LEGAL_CIUDAD=

# Carpeta del VPS con los archivos subidos (fotos y documentos). Debe ser del
# usuario 1000 (el de la API dentro del contenedor).
UPLOADS_DIR_HOST=/srv/vitriauto/uploads
